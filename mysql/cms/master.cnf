[mysqld]
server-id=1
log-bin=mysql-bin

# ─────────────────────────────────────────────────────────────────────
# تنبيه تشغيلي: هذا الملف قد يُتجاهَل كلياً
# ─────────────────────────────────────────────────────────────────────
#
# يرفض MySQL أي ملف إعدادات قابل للكتابة من الجميع، ويطبع:
#
#     World-writable config file '/etc/mysql/conf.d/master.cnf' is ignored
#
# وهذا ما يقع فعلاً هنا: الملف مربوط من نظام ملفات Windows، ولا تُنقل
# صلاحياته إلى الحاوية. فيُتجاهَل الملف بكامله — بما فيه server-id
# و log-bin، أي أن إعداد النسخ المتماثل لا يُطبَّق أيضاً.
#
# ولأن التجاهل صامت ولا يوقف الخادم، يبدو كل شيء سليماً حتى يُكتشف
# أن الإعدادات ليست فعّالة أصلاً. تحقّق دائماً بـ:
#
#     SHOW VARIABLES LIKE 'innodb_ft_min_token_size';
#
# الحلّ المعتمد في هذا المستودع: تُمرَّر الإعدادات نفسها عبر command
# في docker-compose.core.yml، فتتجاوز فحص الصلاحيات كلياً. ويبقى هذا
# الملف مرجعاً موثَّقاً ومسار العمل على مضيف يدعم الصلاحيات (Linux).

# ─────────────────────────────────────────────────────────────────────
# إعدادات البحث النصّي الكامل
# ─────────────────────────────────────────────────────────────────────
#
# هذه ليست ضبطاً للأداء بل شروطاً لصحّة النتائج. القيم الافتراضية في
# MySQL مضبوطة للإنجليزية وحدها، وتُسقط من الفهرس صامتةً ما لا يوافقها.

# ─── الحدّ الأدنى لطول الوحدة ────────────────────────────────────────
#
# الافتراضي 3. وأثره أن كل وحدة أقصر من ثلاثة محارف تختفي من الفهرس
# بلا خطأ ولا تحذير:
#
#   "s24"  تمرّ           لكن "s9" لا تمرّ  → موديلات كاملة غير قابلة للبحث
#   "m3"   لا تمرّ                          → معالجات Apple كلها
#   "من"   لا تمرّ                          → وكثير من الكلمات العربية القصيرة
#
# القيمة 2 تغطّي هذه الحالات وتُبقي الفهرس محكوم الحجم. النزول إلى 1
# يُدخل كل حرف مفرد فينتفخ الفهرس بلا مقابل.
#
# تغيير هذه القيمة يستوجب إعادة بناء الفهارس النصّية:
#   php artisan search:reindex --force
innodb_ft_min_token_size=2

# ─── حجم وحدة الـ ngram ──────────────────────────────────────────────
#
# يحكم فهرس ft_ngram الذي يخدم الصينية واليابانية والتايلندية والخميرية.
#
# اسم المتغيّر ngram_token_size لا innodb_ngram_token_size: هو من متغيّرات
# إضافة الـ ngram نفسها لا من متغيّرات InnoDB، والاسم الخاطئ يُتجاهَل بصمت.
#
# يجب أن يساوي search.indexing.ngram_token_size في ملف الضبط. اختلافهما
# يعني أننا نبحث عن وحدات غير التي فُهرست، فلا يطابق شيء أبداً — وهو
# عطل صامت تماماً: لا خطأ، فقط نتائج فارغة دائمة للغات الآسيوية.
ngram_token_size=2

# ─── قائمة كلمات الوقف المدمجة ──────────────────────────────────────
#
# قائمة InnoDB المدمجة إنجليزية بحتة، وتُطبَّق على كل اللغات. ولها أثران:
#
#   1. كلمة إنجليزية شائعة تسقط من الفهرس، فيعجز البحث عن عبارة
#      تتضمّنها حتى بين علامتَي اقتباس.
#
#   2. اللغات الأخرى لا تنتفع بها إطلاقاً — لا وجود لكلمات وقف عربية
#      أو صينية في تلك القائمة.
#
# إيقافها ينقل سياسة كلمات الوقف بكاملها إلى طبقة التطبيق، حيث تُدار
# لكل script في resources/search/lexicon/*.php. والأهمّ أن BM25 يتولّى
# الأمر إحصائياً: كلمة ترد في كل مستند تحصل على IDF يقارب الصفر، فتُهمَل
# دون أن تختفي — وهو سلوك أصحّ من الحذف القاطع.
innodb_ft_enable_stopword=OFF

# ─── التزامن ────────────────────────────────────────────────────────
#
# يمنع البحث من رؤية إدراجات لم تُدمج بعد في الفهرس الرئيسي. بدونه
# يظهر محتوى جديد في النتائج متأخّراً بلا سبب مفهوم.
innodb_optimize_fulltext_only=OFF
